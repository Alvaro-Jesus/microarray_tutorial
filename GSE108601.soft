^SAMPLE = GSM2905805
!Sample_title = MT1GFP(-)
!Sample_geo_accession = GSM2905805
!Sample_status = Public on Feb 02 2018
!Sample_submission_date = Dec 28 2017
!Sample_last_update_date = Feb 02 2018
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = MT1GFP ( subclone of MT-1 ATL cell line)
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: T-cell
!Sample_characteristics_ch1 = tax expression status: Tax(-)
!Sample_characteristics_ch1 = clone: MT1GFP clone 5-43
!Sample_growth_protocol_ch1 = MT1GFP cell line is maintained in RPMI + 10% FBS + Penicillin/Streptomycin + 0.5 μg/mL G418. KK1GFP cell line is maintained in RPMI + 20% FBS + Penicillin/Streptomycin + 0.5 μg/mL G418 + IL-2 200 U/ml
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = For Both Cell lines (MT1GFP and KK1GFP), FACS sorting was performed to isolate d2EGFP(-) and d2EGFP(+) populations. Cells were sorted directly into RLT buffer from RNeasy Mini Kit (QIAGEN). Subsequently, Total RNA was extracted for cDNA library construction according to manufacturer protocol
!Sample_extract_protocol_ch1 = RNA libraries were prepared for sequencing using standard Illumina protocols
!Sample_description = MT1_CuffDiff_Output.txt
!Sample_data_processing = Tuxedo pipeline was used for generation of CuffDiff output files in the following steps: (1) mapping single-end reads for reference genome using TopHat v2.0.13 (options: -g 1), (2) Transcript assembly using cufflinks v2.2.1, (3) Transcriptome  assembly using cuffmerge v2.2.1, (4) Quantification of differential expression using cuffdiff v2.2.1. All pipeline was performed using default parameters, unless specified.
!Sample_data_processing = Genome_build: hg38
!Sample_data_processing = Supplementary_files_format_and_content: Tab-delimited text files include FPKM values for each Sample and Log ratio for differential expression
!Sample_platform_id = GPL11154
